# Python
__pycache__/
*.pyc

# renders fuente pesados en crudo se versionan solo si son canon; los cortes intermedios no
source/renders/*-cut.png

# modelos 3D en crudo: 78 MB por pieza, diez veces el archivo mas grande del repo.
# Se versiona el master de trabajo (source/3d-models/*.glb), no lo que escupe Meshy.
source/3d-models/crudo/

# fotogramas extraidos de un video: se regeneran del master en source/renders/
source/frames/

# los .blend se regeneran del GLB con tools/a-blend.py en dos segundos
*.blend
*.blend[0-9]
# modelos pulidos y texturizados de Tripo (fuente, como crudo/): no se versionan, el master si
source/3d-models/pulido/
